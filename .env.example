# Local service
SEED_AE_HOST=127.0.0.1
SEED_AE_PORT=47831
# Left at the placeholder (or unset), the service mints a random token per
# process and prints it at startup.
SEED_AE_SESSION_TOKEN=replace-with-random-local-token
# Folder that will contain .seed-ae/ — defaults to the working directory.
SEED_AE_WORKSPACE=

# Volcengine Ark
# The documented image endpoint uses `Authorization: Bearer $ARK_API_KEY`.
# An AK/SK pair is a different credential type; which one applies must be
# verified against official docs before the Seedream adapter is written.
ARK_API_KEY=
SEED_ARK_AK=
SEED_ARK_SK=
ARK_BASE_URL=https://ark.cn-beijing.volces.com
SEEDREAM_MODEL_ID=

# Anthropic API — Milestone 5 (LLM/agent) only.
ANTHROPIC_API_KEY=

# Seedance intentionally unspecified until official 2.5 API contract is verified.
SEEDANCE_MODEL_ID=
