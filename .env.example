# Local service
SEED_AE_HOST=127.0.0.1
SEED_AE_PORT=47831
# Left at the placeholder (or unset), the service mints a random token per
# process and prints it at startup.
SEED_AE_SESSION_TOKEN=replace-with-random-local-token
# Folder that will contain .seed-ae/ — defaults to the working directory.
SEED_AE_WORKSPACE=

# Volcengine / BytePlus Ark
#
# TWO credential systems, both needed for the full feature set:
#   ARK_API_KEY            -> inference (Bearer). Required to generate at all.
#   SEED_ARK_AK / _SK      -> asset library OpenAPI (HMAC signed). Optional;
#                             enables the asset:// reference route.
# They are different credentials from different console pages.
ARK_API_KEY=
SEED_ARK_AK=
SEED_ARK_SK=

# Inference base. Global/SEA route shown; the CN route is
# https://ark.cn-beijing.volces.com/api/v3
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# Model id — never hard-coded. Mind the per-model minimum output area:
# seedream-5-0-260128 and seedream-4-5-251128 need >= 3,686,400 px,
# seedream-4-0-250828 and dola-seedream-5-0-pro-260628 need >= 921,600 px.
SEEDREAM_MODEL_ID=

# Asset library OpenAPI host and region.
ARK_OPENAPI_HOST=open.byteplusapi.com
ARK_REGION=ap-southeast-1
ARK_ASSET_GROUP=seed-ae

# How local AE frames reach the model:
#   asset            register in the asset library; FAIL rather than fall back
#                    (correct when references contain real people)
#   asset-or-inline  register if possible, otherwise send a data URL (default)
#   inline           always send a data URL
ARK_REFERENCE_POLICY=asset-or-inline

# Bypasses the content pre-filter on CreateAsset. Only works if the pre-filter
# is disabled for the account in the console first.
ARK_SKIP_MODERATION=false

# Anthropic API — powers the direction agent, which turns a described shot into
# a proposed generation. Optional: without it the panel hides the Direct button
# and everything else works unchanged.
ANTHROPIC_API_KEY=

# Direction model. Configuration rather than a constant, so it can be changed
# without a release.
SEED_AE_DIRECTOR_MODEL=claude-opus-5

# How hard the direction model thinks. Composing a prompt is a short creative
# task with a picture in front of it, and the artist is waiting on it — low is
# the right shape for the job and roughly halves the wait. Raise it if the
# prompts stop being good: low | medium | high | xhigh | max
SEED_AE_DIRECTOR_EFFORT=low

# Premium-priced fast mode (roughly double the token price, up to 2.5x the
# output speed). Its rate limits are separate from standard and, being a
# research preview, may refuse — SEED reports that rather than hanging.
SEED_AE_DIRECTOR_FAST=false

# Premiere only: a PNG still preset (.epr) exported from Premiere's Export
# Settings dialog. Presets are per-install so none can be shipped. Without it,
# Premiere frame capture relies on the undocumented QE exporter alone.
SEED_PPRO_STILL_PRESET=

# Offers the mock image/video providers alongside the real ones. Off unless
# this is exactly "true" — they exist for running the workflow without
# credentials, not for picking from a list next to the real thing.
SEED_AE_MOCK_PROVIDERS=false

# Seedance models to offer, comma-separated, in panel order. Each becomes its
# own provider entry, because 2.0 and 2.5 differ in what they accept. List what
# the account actually has: npx tsx --env-file=.env scripts/ark-models.ts seedance
SEEDANCE_MODEL_ID=dreamina-seedance-2-5-260628,dreamina-seedance-2-0-260128

# Resolutions offered for every Seedance model. Defaults to 480p,720p,1080p —
# the set every model accepted consistently. See docs/research/MODEL_API_NOTES.md
# before widening it: the API reports one complaint per request, so a probe
# cannot always tell an accepted resolution from an unread one.
SEEDANCE_SIZES=

# How many reference images Seedance is offered. Validation accepted 64 and
# ByteDance's launch material says 30, but only a handful have been generated
# with — see docs/research/MODEL_API_NOTES.md. Default 30.
SEEDANCE_MAX_REFERENCES=
