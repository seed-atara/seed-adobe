# Local service
SEED_AE_HOST=127.0.0.1
SEED_AE_PORT=47831
# Left at the placeholder (or unset), the service mints a random token per
# process and prints it at startup.
SEED_AE_SESSION_TOKEN=replace-with-random-local-token
# Folder that will contain .seed-ae/ — defaults to the working directory.
SEED_AE_WORKSPACE=

# Volcengine / BytePlus Ark
#
# TWO credential systems, both needed for the full feature set:
#   ARK_API_KEY            -> inference (Bearer). Required to generate at all.
#   SEED_ARK_AK / _SK      -> asset library OpenAPI (HMAC signed). Optional;
#                             enables the asset:// reference route.
# They are different credentials from different console pages.
ARK_API_KEY=
SEED_ARK_AK=
SEED_ARK_SK=

# Inference base. Global/SEA route shown; the CN route is
# https://ark.cn-beijing.volces.com/api/v3
ARK_BASE_URL=https://ark.ap-southeast.bytepluses.com/api/v3

# Model id — never hard-coded. Mind the per-model minimum output area:
# seedream-5-0-260128 and seedream-4-5-251128 need >= 3,686,400 px,
# seedream-4-0-250828 and dola-seedream-5-0-pro-260628 need >= 921,600 px.
SEEDREAM_MODEL_ID=

# Asset library OpenAPI host and region.
ARK_OPENAPI_HOST=open.byteplusapi.com
ARK_REGION=ap-southeast-1
ARK_ASSET_GROUP=seed-ae

# How local AE frames reach the model:
#   asset            register in the asset library; FAIL rather than fall back
#                    (correct when references contain real people)
#   asset-or-inline  register if possible, otherwise send a data URL (default)
#   inline           always send a data URL
ARK_REFERENCE_POLICY=asset-or-inline

# Bypasses the content pre-filter on CreateAsset. Only works if the pre-filter
# is disabled for the account in the console first.
ARK_SKIP_MODERATION=false

# Anthropic API — Milestone 5 (LLM/agent) only.
ANTHROPIC_API_KEY=

# Premiere only: a PNG still preset (.epr) exported from Premiere's Export
# Settings dialog. Presets are per-install so none can be shipped. Without it,
# Premiere frame capture relies on the undocumented QE exporter alone.
SEED_PPRO_STILL_PRESET=

# Seedance intentionally unspecified until official 2.5 API contract is verified.
SEEDANCE_MODEL_ID=
