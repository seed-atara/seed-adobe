{
  "name": "seed-ae",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @seed-ae/service",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/panel/tsconfig.json --noEmit",
    "lint": "npm run typecheck",
    "setup": "node scripts/setup.mjs",
    "install:extension": "node scripts/install-extension.mjs",
    "uninstall:extension": "node scripts/install-extension.mjs --uninstall",
    "token": "node scripts/token.mjs",
    "watch:seedream": "node scripts/watch-seedream.mjs",
    "plugin:vectors": "tsx scripts/filmlook-vectors.ts",
    "plugin:test": "node scripts/plugin-test.mjs",
    "plugin:build": "node scripts/plugin-build.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
