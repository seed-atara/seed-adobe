{
  "name": "seed-ae",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @seed-ae/service",
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.scripts.json && tsc -p apps/panel/tsconfig.json --noEmit && tsc -p apps/installer/tsconfig.json --noEmit",
    "lint": "npm run typecheck",
    "setup": "node scripts/setup.mjs",
    "install:extension": "node scripts/install-extension.mjs",
    "uninstall:extension": "node scripts/install-extension.mjs --uninstall",
    "token": "node scripts/token.mjs",
    "watch:seedream": "node scripts/watch-seedream.mjs",
    "plugin:vectors": "tsx scripts/filmlook-vectors.ts",
    "plugin:test": "node scripts/plugin-test.mjs",
    "plugin:build": "node scripts/plugin-cmd.mjs seed-film-look build-aex.cmd",
    "plugin:install": "node scripts/plugin-cmd.mjs seed-film-look install.cmd",
    "detailer:test": "node scripts/plugin-cmd.mjs seed-frequency-detailer build-core-test.cmd",
    "detailer:build": "node scripts/plugin-cmd.mjs seed-frequency-detailer build-aex.cmd",
    "detailer:install": "node scripts/plugin-cmd.mjs seed-frequency-detailer install.cmd",
    "companion": "npm run build --workspace @seed-ae/installer",
    "companion:win": "npm run dist:win --workspace @seed-ae/installer",
    "companion:mac": "npm run dist:mac --workspace @seed-ae/installer"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  }
}
