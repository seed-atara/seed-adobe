<?xml version="1.0" encoding="UTF-8"?>
<!--
  Enables CEF remote debugging for the panel.

  With this file present (and PlayerDebugMode on, which the installer sets),
  open http://localhost:8088 in Chrome while the panel is loaded in After
  Effects to get real DevTools: console, network, elements.

  This is how you diagnose "the panel is blank" or "capture did nothing" —
  ExtendScript errors surface in the panel's console, not in AE.
-->
<ExtensionList>
  <Extension Id="ai.seedstudios.seedae.panel">
    <HostList>
      <Host Name="AEFT" Port="8088" />
    </HostList>
  </Extension>
</ExtensionList>
